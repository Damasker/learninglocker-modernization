# Lab overlay for Learning Locker app (.env)
# Apply on top of .env.example. Do not commit real APP_SECRET values.

NODE_ENV=development
SITE_URL=http://127.0.0.1:3000
UI_PORT=3000
UI_HOST=127.0.0.1
API_PORT=8080
API_HOST=127.0.0.1

# Fill per host with: openssl rand -hex 32
APP_SECRET=REPLACE_ME

MONGODB_PATH=mongodb://127.0.0.1:27017/learninglocker_v2?replicaSet=rs0
MONGODB_TEST_PATH=mongodb://127.0.0.1:27017/llv2tests?replicaSet=rs0

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=LEARNINGLOCKER
QUEUE_PROVIDER=REDIS
QUEUE_NAMESPACE=LAB

FS_REPO=local
GOOGLE_ENABLED=false
LOG_MIN_LEVEL=info
COLOR_LOGS=true

# API strangler: native /v2 routers (ADR 0014 stage 3 lab default on).
# Code defaults remain false; ll-legacy forces off via app.env.overlay.legacy-restify.
ENABLE_NATIVE_CLIENT_ROUTER=true
ENABLE_NATIVE_LRS_ROUTER=true
ENABLE_NATIVE_ORGANISATION_ROUTER=true
ENABLE_NATIVE_ROLE_ROUTER=true
ENABLE_NATIVE_USER_ROUTER=true
ENABLE_NATIVE_DASHBOARD_ROUTER=true
ENABLE_NATIVE_VISUALISATION_ROUTER=true
ENABLE_NATIVE_QUERY_ROUTER=true
ENABLE_NATIVE_EXPORT_ROUTER=true
ENABLE_NATIVE_DOWNLOAD_ROUTER=true
ENABLE_NATIVE_PERSONA_ATTRIBUTE_ROUTER=true
ENABLE_NATIVE_PERSONAS_IMPORT_ROUTER=true
ENABLE_NATIVE_PERSONAS_IMPORT_TEMPLATE_ROUTER=true
ENABLE_NATIVE_IMPORT_CSV_ROUTER=true
ENABLE_NATIVE_SITE_SETTINGS_ROUTER=true
ENABLE_NATIVE_STREAM_ROUTER=true
ENABLE_NATIVE_BATCH_DELETE_ROUTER=true
ENABLE_NATIVE_STATEMENT_FORWARDING_ROUTER=true
ENABLE_NATIVE_QUERY_BUILDER_CACHE_ROUTER=true
ENABLE_NATIVE_QUERY_BUILDER_CACHE_VALUE_ROUTER=true
ENABLE_NATIVE_STATEMENT_ROUTER=true
ENABLE_NATIVE_STATEMENT_AGGREGATE_ROUTER=true
