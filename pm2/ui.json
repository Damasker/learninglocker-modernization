{
  "apps": [
    {
      "name": "UIServer",
      "script": "ui/dist/server",
      "cwd": ".",
      "output": "./logs/ui_stdout.log",
      "error": "./logs/ui_stderr.log",
      "pid": "./pids/ui.pid",
      "instances": 1,
      "exec_mode": "fork",
      "wait_ready": true,
      "listen_timeout": 60000,
      "node_args": "--max-old-space-size=512",
      "watch": false
    }
  ]
}
